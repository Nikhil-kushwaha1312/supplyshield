# SupplyShield environment variables
# Copy this file to .env and fill in your key

# Required for LLM features (Module 2 & 4: disruption simulation + strategy generation)
# Get a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Kaggle API credentials for downloading real datasets directly
# Get credentials from: https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME_HERE
KAGGLE_KEY=YOUR_KAGGLE_API_KEY_HERE
